{
  "name": "radiprotocol",
  "version": "3.6.24",
  "description": "Guided structured radiology protocol runner for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint . --max-warnings 0 && stylelint src/styles/**/*.css",
    "lint:strict": "npm run lint",
    "test": "vitest run",
    "knip": "knip",
    "check:planning": "node scripts/check-planning-freshness.mjs",
    "check:consistency": "node scripts/check-consistency.mjs",
    "check:agent-docs": "node scripts/check-agent-docs.mjs",
    "check:css": "node scripts/check-css-classes.mjs",
    "audit:i18n": "node scripts/audit-i18n-ui-text.mjs",
    "check": "npm run build && npm run lint && npm test && npm run check:planning && npm run check:consistency && npm run check:agent-docs",
    "check:release": "npm run check && npm run check:css && npm run audit:i18n"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "9.30.1",
    "@types/dagre": "^0.7.54",
    "@types/node": "^22.0.0",
    "builtin-modules": "4.0.0",
    "dotenv": "17.4.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "0.1.9",
    "globals": "17.4.0",
    "knip": "^6.4.1",
    "stylelint": "^17.9.1",
    "stylelint-config-standard": "^40.0.0",
    "tslib": "2.4.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.58.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "async-mutex": "^0.5.0",
    "dagre": "^0.8.5",
    "obsidian": "1.12.3"
  }
}
